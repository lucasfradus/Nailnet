generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  MASTER_FRANQUICIADOR
  FRANQUICIADO
  ADMIN_SEDE
  RECEPCIONISTA
  PROFESIONAL
}

enum Alcance {
  ORGANIZACION
  FRANQUICIADO
  SEDE
  PROPIO
}

enum TipoIntentoAcceso {
  LOGIN
  RECUPERACION
}

enum Proveedor {
  MERCADO_PAGO
  FACTURANTE
}

enum Sexo {
  FEMENINO
  MASCULINO
  OTRO
  NO_INFORMA
}

enum TipoDocumento {
  DNI
  CUIT
  CUIL
  PASAPORTE
}

enum TipoConsentimiento {
  PRACTICA
  TERMINOS
  MARKETING
}

enum AccionConsentimiento {
  ACEPTA
  REVOCA
}

enum CanalConsentimiento {
  RECEPCION
  PORTAL
}

enum TipoSena {
  NINGUNA
  FIJA
  PORCENTAJE
}

enum Ambiente {
  PRUEBA
  PRODUCCION
}

model Organizacion {
  id              String                     @id @default(uuid()) @db.Uuid
  nombre          String
  activo          Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  franquiciados   Franquiciado[]
  membresias      MembresiaOrganizacion[]
  emisores        EmisorFiscal[]
  auditoria       AuditLog[]
  configuracion   ConfiguracionOrganizacion?
  clientes        Cliente[]
  consentimientos ConsentimientoVersion[]
  categorias      CategoriaServicio[]
  servicios       Servicio[]
  skills          Skill[]
  tiposRecurso    TipoRecurso[]
}

model Franquiciado {
  id             String          @id @default(uuid()) @db.Uuid
  organizacionId String          @db.Uuid
  nombre         String
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sedes          Sede[]
  asignaciones   AsignacionRol[]

  @@unique([organizacionId, id])
}

model Sede {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizacionId          String                    @db.Uuid
  franquiciadoId          String                    @db.Uuid
  nombre                  String
  timezone                String                    @default("America/Argentina/Buenos_Aires")
  activo                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  franquiciado            Franquiciado              @relation(fields: [organizacionId, franquiciadoId], references: [organizacionId, id], onDelete: Restrict)
  asignaciones            AsignacionRol[]
  configuracionesFiscales ConfiguracionFiscalSede[]
  configuracion           ConfiguracionSede?
  credenciales            CredencialProveedor[]
  clientes                ClienteSede[]
  consentimientos         ClienteConsentimiento[]
  servicios               ServicioSede[]

  @@unique([organizacionId, id])
  @@index([organizacionId, franquiciadoId])
}

model Usuario {
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String                  @unique
  nombre                String
  passwordHash          String?
  passwordActualizadaEn DateTime?
  activo                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  membresias            MembresiaOrganizacion[]
  sesiones              Sesion[]
  tokensRecuperacion    TokenRecuperacion[]
}

// Solo se persiste el hash SHA-256 del token; el valor viaja una vez al navegador o al email.
model Sesion {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now())
  ultimoUso  DateTime  @default(now())
  expiraEn   DateTime
  revocadaEn DateTime?
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
}

model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now())
  expiraEn  DateTime
  usadoEn   DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
}

// Registro durable para limitar intentos por email e IP; no guarda contraseñas.
model IntentoAcceso {
  id        String            @id @default(uuid()) @db.Uuid
  tipo      TipoIntentoAcceso
  email     String
  ip        String?
  exitoso   Boolean
  createdAt DateTime          @default(now())

  @@index([tipo, email, createdAt])
  @@index([tipo, ip, createdAt])
}

model MembresiaOrganizacion {
  organizacionId String          @db.Uuid
  usuarioId      String          @db.Uuid
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  asignaciones   AsignacionRol[]

  @@id([organizacionId, usuarioId])
}

model AsignacionRol {
  id             String                @id @default(uuid()) @db.Uuid
  organizacionId String                @db.Uuid
  usuarioId      String                @db.Uuid
  rol            Rol
  alcance        Alcance
  franquiciadoId String?               @db.Uuid
  sedeId         String?               @db.Uuid
  createdAt      DateTime              @default(now())
  membresia      MembresiaOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict)
  franquiciado   Franquiciado?         @relation(fields: [organizacionId, franquiciadoId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede?                 @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([organizacionId, usuarioId])
}

model EmisorFiscal {
  id              String                    @id @default(uuid()) @db.Uuid
  organizacionId  String                    @db.Uuid
  cuit            String                    @db.VarChar(11)
  razonSocial     String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  organizacion    Organizacion              @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  configuraciones ConfiguracionFiscalSede[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, cuit])
}

model ConfiguracionFiscalSede {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String       @db.Uuid
  emisorFiscalId String       @db.Uuid
  ambiente       Ambiente
  puntoVenta     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sede           Sede         @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  emisorFiscal   EmisorFiscal @relation(fields: [organizacionId, emisorFiscalId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, sedeId, ambiente])
  @@unique([emisorFiscalId, ambiente, puntoVenta])
}

// Trazabilidad mínima de cambios de estructura y permisos. Nunca guarda secretos, tokens ni contraseñas.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  actorId        String?      @db.Uuid
  accion         String
  entidad        String
  entidadId      String
  datos          Json?
  createdAt      DateTime     @default(now())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)

  @@index([organizacionId, createdAt])
  @@index([entidad, entidadId])
}

// Parámetros operativos con herencia organización → sede. null = heredar / sin definir.
model ConfiguracionOrganizacion {
  organizacionId            String       @id @db.Uuid
  horizonteReservaDias      Int?
  anticipacionMinimaMinutos Int?
  updatedAt                 DateTime     @updatedAt
  organizacion              Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
}

model ConfiguracionSede {
  organizacionId            String   @db.Uuid
  sedeId                    String   @id @db.Uuid
  horizonteReservaDias      Int?
  anticipacionMinimaMinutos Int?
  updatedAt                 DateTime @updatedAt
  sede                      Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, sedeId])
}

// Credenciales de proveedor por sede y ambiente (D8). Los secretos se guardan cifrados con versión de
// clave; las claves viven fuera de la base. cuentaExterna impide compartir una cuenta receptora entre sedes.
model CredencialProveedor {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @db.Uuid
  sedeId         String    @db.Uuid
  proveedor      Proveedor
  ambiente       Ambiente
  cuentaExterna  String?
  publicos       Json
  secretoCifrado String
  pista          String
  actualizadoPor String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sede           Sede      @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([sedeId, proveedor, ambiente])
  @@unique([proveedor, ambiente, cuentaExterna])
  @@index([organizacionId])
}

// Identidad compartida en la organización (D13). Sin datos de salud ni fotos.
model Cliente {
  id              String                  @id @default(uuid()) @db.Uuid
  organizacionId  String                  @db.Uuid
  nombre          String
  apellido        String?
  email           String?
  telefono        String?
  sexo            Sexo?
  tipoDocumento   TipoDocumento?
  documento       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organizacion    Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sedes           ClienteSede[]
  consentimientos ClienteConsentimiento[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, email])
  @@unique([organizacionId, tipoDocumento, documento])
  @@index([organizacionId, telefono])
}

// Relación del cliente con cada sede; las observaciones son locales y solo las ve quien alcanza la sede.
model ClienteSede {
  organizacionId String   @db.Uuid
  clienteId      String   @db.Uuid
  sedeId         String   @db.Uuid
  observaciones  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cliente        Cliente  @relation(fields: [organizacionId, clienteId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@id([clienteId, sedeId])
  @@index([organizacionId, sedeId])
}

// Texto versionado e inmutable. Cambiar el texto es crear otra versión.
model ConsentimientoVersion {
  id             String                  @id @default(uuid()) @db.Uuid
  organizacionId String                  @db.Uuid
  tipo           TipoConsentimiento
  clave          String
  version        Int
  titulo         String
  texto          String
  creadoPor      String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  organizacion   Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  registros      ClienteConsentimiento[]

  @@unique([organizacionId, clave, version])
  @@unique([organizacionId, id])
}

// Registro inmutable de aceptación o revocación: el estado surge del último registro.
model ClienteConsentimiento {
  id             String                @id @default(uuid()) @db.Uuid
  organizacionId String                @db.Uuid
  clienteId      String                @db.Uuid
  versionId      String                @db.Uuid
  sedeId         String?               @db.Uuid
  accion         AccionConsentimiento
  canal          CanalConsentimiento
  registradoPor  String?               @db.Uuid
  evidencia      Json?
  // Desempata registros del mismo milisegundo: el estado lo define el último insertado.
  orden          Int                   @default(autoincrement())
  createdAt      DateTime              @default(now())
  cliente        Cliente               @relation(fields: [organizacionId, clienteId], references: [organizacionId, id], onDelete: Restrict)
  version        ConsentimientoVersion @relation(fields: [organizacionId, versionId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede?                 @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([organizacionId, clienteId, createdAt])
}

// Catálogo global de la organización (propuesta D12); precio y habilitación son por sede.
model CategoriaServicio {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  nombre         String
  orden          Int          @default(0)
  activo         Boolean      @default(true)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  servicios      Servicio[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

model Servicio {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizacionId       String                     @db.Uuid
  categoriaId          String                     @db.Uuid
  nombre               String
  descripcion          String?
  duracionMinutos      Int
  bufferAntesMinutos   Int                        @default(0)
  bufferDespuesMinutos Int                        @default(0)
  // Seña por defecto del servicio. null = sin definir (D3 pendiente): no se ofrece online.
  senaTipo             TipoSena?
  senaValor            Decimal?                   @db.Decimal(12, 2)
  activo               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  organizacion         Organizacion               @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  categoria            CategoriaServicio          @relation(fields: [organizacionId, categoriaId], references: [organizacionId, id], onDelete: Restrict)
  skills               ServicioSkill[]
  recursos             ServicioRequisitoRecurso[]
  consentimientos      ServicioConsentimiento[]
  sedes                ServicioSede[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

model Skill {
  id             String          @id @default(uuid()) @db.Uuid
  organizacionId String          @db.Uuid
  nombre         String
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  servicios      ServicioSkill[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

// El profesional debe tener TODAS las skills requeridas por el servicio.
model ServicioSkill {
  organizacionId String   @db.Uuid
  servicioId     String   @db.Uuid
  skillId        String   @db.Uuid
  servicio       Servicio @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Cascade)
  skill          Skill    @relation(fields: [organizacionId, skillId], references: [organizacionId, id], onDelete: Restrict)

  @@id([servicioId, skillId])
}

model TipoRecurso {
  id             String                     @id @default(uuid()) @db.Uuid
  organizacionId String                     @db.Uuid
  nombre         String
  organizacion   Organizacion               @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  requisitos     ServicioRequisitoRecurso[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

// Cantidad de unidades distintas de un tipo que el servicio ocupa durante todo el intervalo.
model ServicioRequisitoRecurso {
  organizacionId String      @db.Uuid
  servicioId     String      @db.Uuid
  tipoRecursoId  String      @db.Uuid
  cantidad       Int
  servicio       Servicio    @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Cascade)
  tipoRecurso    TipoRecurso @relation(fields: [organizacionId, tipoRecursoId], references: [organizacionId, id], onDelete: Restrict)

  @@id([servicioId, tipoRecursoId])
}

// Consentimiento exigido por el servicio, por clave: siempre rige la versión vigente.
model ServicioConsentimiento {
  organizacionId String   @db.Uuid
  servicioId     String   @db.Uuid
  clave          String
  servicio       Servicio @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Cascade)

  @@id([servicioId, clave])
}

model ServicioSede {
  organizacionId   String    @db.Uuid
  servicioId       String    @db.Uuid
  sedeId           String    @db.Uuid
  habilitado       Boolean   @default(false)
  precio           Decimal?  @db.Decimal(12, 2)
  duracionMinutos  Int?
  senaTipo         TipoSena?
  senaValor        Decimal?  @db.Decimal(12, 2)
  reservableOnline Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
  servicio         Servicio  @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Restrict)
  sede             Sede      @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@id([servicioId, sedeId])
  @@index([organizacionId, sedeId])
}
