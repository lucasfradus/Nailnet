generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  MASTER_FRANQUICIADOR
  FRANQUICIADO
  ADMIN_SEDE
  RECEPCIONISTA
  PROFESIONAL
}

enum Alcance {
  ORGANIZACION
  FRANQUICIADO
  SEDE
  PROPIO
}

enum TipoIntentoAcceso {
  LOGIN
  RECUPERACION
}

enum Proveedor {
  MERCADO_PAGO
  FACTURANTE
}

enum Ambiente {
  PRUEBA
  PRODUCCION
}

model Organizacion {
  id            String                     @id @default(uuid()) @db.Uuid
  nombre        String
  activo        Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  franquiciados Franquiciado[]
  membresias    MembresiaOrganizacion[]
  emisores      EmisorFiscal[]
  auditoria     AuditLog[]
  configuracion ConfiguracionOrganizacion?
}

model Franquiciado {
  id             String          @id @default(uuid()) @db.Uuid
  organizacionId String          @db.Uuid
  nombre         String
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sedes          Sede[]
  asignaciones   AsignacionRol[]

  @@unique([organizacionId, id])
}

model Sede {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizacionId          String                    @db.Uuid
  franquiciadoId          String                    @db.Uuid
  nombre                  String
  timezone                String                    @default("America/Argentina/Buenos_Aires")
  activo                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  franquiciado            Franquiciado              @relation(fields: [organizacionId, franquiciadoId], references: [organizacionId, id], onDelete: Restrict)
  asignaciones            AsignacionRol[]
  configuracionesFiscales ConfiguracionFiscalSede[]
  configuracion           ConfiguracionSede?
  credenciales            CredencialProveedor[]

  @@unique([organizacionId, id])
  @@index([organizacionId, franquiciadoId])
}

model Usuario {
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String                  @unique
  nombre                String
  passwordHash          String?
  passwordActualizadaEn DateTime?
  activo                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  membresias            MembresiaOrganizacion[]
  sesiones              Sesion[]
  tokensRecuperacion    TokenRecuperacion[]
}

// Solo se persiste el hash SHA-256 del token; el valor viaja una vez al navegador o al email.
model Sesion {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now())
  ultimoUso  DateTime  @default(now())
  expiraEn   DateTime
  revocadaEn DateTime?
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
}

model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now())
  expiraEn  DateTime
  usadoEn   DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
}

// Registro durable para limitar intentos por email e IP; no guarda contraseñas.
model IntentoAcceso {
  id        String            @id @default(uuid()) @db.Uuid
  tipo      TipoIntentoAcceso
  email     String
  ip        String?
  exitoso   Boolean
  createdAt DateTime          @default(now())

  @@index([tipo, email, createdAt])
  @@index([tipo, ip, createdAt])
}

model MembresiaOrganizacion {
  organizacionId String          @db.Uuid
  usuarioId      String          @db.Uuid
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  asignaciones   AsignacionRol[]

  @@id([organizacionId, usuarioId])
}

model AsignacionRol {
  id             String                @id @default(uuid()) @db.Uuid
  organizacionId String                @db.Uuid
  usuarioId      String                @db.Uuid
  rol            Rol
  alcance        Alcance
  franquiciadoId String?               @db.Uuid
  sedeId         String?               @db.Uuid
  createdAt      DateTime              @default(now())
  membresia      MembresiaOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict)
  franquiciado   Franquiciado?         @relation(fields: [organizacionId, franquiciadoId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede?                 @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([organizacionId, usuarioId])
}

model EmisorFiscal {
  id              String                    @id @default(uuid()) @db.Uuid
  organizacionId  String                    @db.Uuid
  cuit            String                    @db.VarChar(11)
  razonSocial     String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  organizacion    Organizacion              @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  configuraciones ConfiguracionFiscalSede[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, cuit])
}

model ConfiguracionFiscalSede {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String       @db.Uuid
  emisorFiscalId String       @db.Uuid
  ambiente       Ambiente
  puntoVenta     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sede           Sede         @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  emisorFiscal   EmisorFiscal @relation(fields: [organizacionId, emisorFiscalId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, sedeId, ambiente])
  @@unique([emisorFiscalId, ambiente, puntoVenta])
}

// Trazabilidad mínima de cambios de estructura y permisos. Nunca guarda secretos, tokens ni contraseñas.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  actorId        String?      @db.Uuid
  accion         String
  entidad        String
  entidadId      String
  datos          Json?
  createdAt      DateTime     @default(now())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)

  @@index([organizacionId, createdAt])
  @@index([entidad, entidadId])
}

// Parámetros operativos con herencia organización → sede. null = heredar / sin definir.
model ConfiguracionOrganizacion {
  organizacionId            String       @id @db.Uuid
  horizonteReservaDias      Int?
  anticipacionMinimaMinutos Int?
  updatedAt                 DateTime     @updatedAt
  organizacion              Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
}

model ConfiguracionSede {
  organizacionId            String   @db.Uuid
  sedeId                    String   @id @db.Uuid
  horizonteReservaDias      Int?
  anticipacionMinimaMinutos Int?
  updatedAt                 DateTime @updatedAt
  sede                      Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, sedeId])
}

// Credenciales de proveedor por sede y ambiente (D8). Los secretos se guardan cifrados con versión de
// clave; las claves viven fuera de la base. cuentaExterna impide compartir una cuenta receptora entre sedes.
model CredencialProveedor {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @db.Uuid
  sedeId         String    @db.Uuid
  proveedor      Proveedor
  ambiente       Ambiente
  cuentaExterna  String?
  publicos       Json
  secretoCifrado String
  pista          String
  actualizadoPor String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sede           Sede      @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([sedeId, proveedor, ambiente])
  @@unique([proveedor, ambiente, cuentaExterna])
  @@index([organizacionId])
}
