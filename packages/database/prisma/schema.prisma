generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum Rol {
  MASTER_FRANQUICIADOR
  FRANQUICIADO
  ADMIN_SEDE
  RECEPCIONISTA
  PROFESIONAL
}

enum Alcance {
  ORGANIZACION
  FRANQUICIADO
  SEDE
  PROPIO
}

enum TipoIntentoAcceso {
  LOGIN
  RECUPERACION
}

enum Proveedor {
  MERCADO_PAGO
  FACTURANTE
}

enum Sexo {
  FEMENINO
  MASCULINO
  OTRO
  NO_INFORMA
}

enum TipoDocumento {
  DNI
  CUIT
  CUIL
  PASAPORTE
}

enum TipoConsentimiento {
  PRACTICA
  TERMINOS
  MARKETING
}

enum AccionConsentimiento {
  ACEPTA
  REVOCA
}

enum CanalConsentimiento {
  RECEPCION
  PORTAL
}

enum TipoSena {
  NINGUNA
  FIJA
  PORCENTAJE
}

enum CanalReserva {
  ONLINE
  RECEPCION
}

enum EstadoReserva {
  PENDIENTE_PAGO
  PAGO_EN_REVISION
  CONFIRMADA
  ATENDIDA
  AUSENTE
  CANCELADA
  EXPIRADA
}

enum TipoEventoReserva {
  CREADA
  CONFIRMADA
  EXPIRADA
  CANCELADA
  REPROGRAMADA
  ATENDIDA
  AUSENTE
}

enum Ambiente {
  PRUEBA
  PRODUCCION
}

// R04. Estado de un pago del proveedor, tal como lo aplicamos a la reserva.
enum EstadoPago {
  EN_PROCESO
  APROBADO
  RECHAZADO
  // Cobrado pero sin turno que confirmar (horario ocupado, reserva cancelada, duplicado o monto distinto).
  // La devolución es manual hasta M01/D7.
  A_DEVOLVER
  REEMBOLSADO
}

model Organizacion {
  id              String                     @id @default(uuid()) @db.Uuid
  nombre          String
  // Identificador público para el portal (URL). Opcional hasta publicar la organización.
  slug            String?                    @unique
  activo          Boolean                    @default(true)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  franquiciados   Franquiciado[]
  membresias      MembresiaOrganizacion[]
  emisores        EmisorFiscal[]
  auditoria       AuditLog[]
  configuracion   ConfiguracionOrganizacion?
  clientes        Cliente[]
  consentimientos ConsentimientoVersion[]
  categorias      CategoriaServicio[]
  servicios       Servicio[]
  skills          Skill[]
  tiposRecurso    TipoRecurso[]
  profesionales   Profesional[]
  excepciones     ExcepcionHorario[]
  imagenes        Imagen[]
  categoriasGasto CategoriaGasto[]
  productos       Producto[]
}

model Franquiciado {
  id             String          @id @default(uuid()) @db.Uuid
  organizacionId String          @db.Uuid
  nombre         String
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sedes          Sede[]
  asignaciones   AsignacionRol[]

  @@unique([organizacionId, id])
}

model Sede {
  id                      String                    @id @default(uuid()) @db.Uuid
  organizacionId          String                    @db.Uuid
  franquiciadoId          String                    @db.Uuid
  nombre                  String
  timezone                String                    @default("America/Argentina/Buenos_Aires")
  activo                  Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  franquiciado            Franquiciado              @relation(fields: [organizacionId, franquiciadoId], references: [organizacionId, id], onDelete: Restrict)
  asignaciones            AsignacionRol[]
  configuracionesFiscales ConfiguracionFiscalSede[]
  configuracion           ConfiguracionSede?
  credenciales            CredencialProveedor[]
  clientes                ClienteSede[]
  consentimientos         ClienteConsentimiento[]
  servicios               ServicioSede[]
  profesionales           ProfesionalSede[]
  horarios                HorarioSede[]
  horariosProfesionales   HorarioProfesional[]
  excepciones             ExcepcionHorario[]
  recursos                Recurso[]
  reservas                Reserva[]
  categoriasGasto         CategoriaGasto[]
  gastos                  Gasto[]
  productos               ProductoSede[]
  stock                   StockSede[]
  movimientosStock        MovimientoStock[]
  compras                 Compra[]
  ventas                  Venta[]
  cobrosVenta             CobroVenta[]
  cajas                   Caja[]
  movimientosCaja         MovimientoCaja[]
  presencias              PresenciaProfesional[]

  @@unique([organizacionId, id])
  @@index([organizacionId, franquiciadoId])
}

model Usuario {
  id                    String                  @id @default(uuid()) @db.Uuid
  email                 String                  @unique
  nombre                String
  passwordHash          String?
  passwordActualizadaEn DateTime?
  activo                Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  membresias            MembresiaOrganizacion[]
  sesiones              Sesion[]
  tokensRecuperacion    TokenRecuperacion[]
}

// Solo se persiste el hash SHA-256 del token; el valor viaja una vez al navegador o al email.
model Sesion {
  id         String    @id @default(uuid()) @db.Uuid
  usuarioId  String    @db.Uuid
  tokenHash  String    @unique @db.Char(64)
  createdAt  DateTime  @default(now())
  ultimoUso  DateTime  @default(now())
  expiraEn   DateTime
  revocadaEn DateTime?
  usuario    Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
}

model TokenRecuperacion {
  id        String    @id @default(uuid()) @db.Uuid
  usuarioId String    @db.Uuid
  tokenHash String    @unique @db.Char(64)
  createdAt DateTime  @default(now())
  expiraEn  DateTime
  usadoEn   DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([usuarioId])
}

// Registro durable para limitar intentos por email e IP; no guarda contraseñas.
model IntentoAcceso {
  id        String            @id @default(uuid()) @db.Uuid
  tipo      TipoIntentoAcceso
  email     String
  ip        String?
  exitoso   Boolean
  createdAt DateTime          @default(now())

  @@index([tipo, email, createdAt])
  @@index([tipo, ip, createdAt])
}

model MembresiaOrganizacion {
  organizacionId String          @db.Uuid
  usuarioId      String          @db.Uuid
  activo         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organizacion   Organizacion    @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  asignaciones   AsignacionRol[]

  @@id([organizacionId, usuarioId])
}

model AsignacionRol {
  id             String                @id @default(uuid()) @db.Uuid
  organizacionId String                @db.Uuid
  usuarioId      String                @db.Uuid
  rol            Rol
  alcance        Alcance
  franquiciadoId String?               @db.Uuid
  sedeId         String?               @db.Uuid
  createdAt      DateTime              @default(now())
  membresia      MembresiaOrganizacion @relation(fields: [organizacionId, usuarioId], references: [organizacionId, usuarioId], onDelete: Restrict)
  franquiciado   Franquiciado?         @relation(fields: [organizacionId, franquiciadoId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede?                 @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([organizacionId, usuarioId])
}

model EmisorFiscal {
  id              String                    @id @default(uuid()) @db.Uuid
  organizacionId  String                    @db.Uuid
  cuit            String                    @db.VarChar(11)
  razonSocial     String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  organizacion    Organizacion              @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  configuraciones ConfiguracionFiscalSede[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, cuit])
}

model ConfiguracionFiscalSede {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String       @db.Uuid
  emisorFiscalId String       @db.Uuid
  ambiente       Ambiente
  puntoVenta     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  sede           Sede         @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  emisorFiscal   EmisorFiscal @relation(fields: [organizacionId, emisorFiscalId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, sedeId, ambiente])
  @@unique([emisorFiscalId, ambiente, puntoVenta])
}

// Trazabilidad mínima de cambios de estructura y permisos. Nunca guarda secretos, tokens ni contraseñas.
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  actorId        String?      @db.Uuid
  accion         String
  entidad        String
  entidadId      String
  datos          Json?
  createdAt      DateTime     @default(now())
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)

  @@index([organizacionId, createdAt])
  @@index([entidad, entidadId])
}

// Parámetros operativos con herencia organización → sede. null = heredar / sin definir.
model ConfiguracionOrganizacion {
  organizacionId            String       @id @db.Uuid
  horizonteReservaDias      Int?
  anticipacionMinimaMinutos Int?
  pasoGrillaMinutos         Int?
  retencionMinutos          Int?
  // D6: si recepción exige seña por Mercado Pago. null = heredar; sin valor en ningún nivel = no exige.
  recepcionExigeSena        Boolean?
  updatedAt                 DateTime     @updatedAt
  organizacion              Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
}

model ConfiguracionSede {
  organizacionId            String   @db.Uuid
  sedeId                    String   @id @db.Uuid
  horizonteReservaDias      Int?
  anticipacionMinimaMinutos Int?
  pasoGrillaMinutos         Int?
  retencionMinutos          Int?
  // D6: si recepción exige seña por Mercado Pago. null = heredar; sin valor en ningún nivel = no exige.
  recepcionExigeSena        Boolean?
  updatedAt                 DateTime @updatedAt
  sede                      Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, sedeId])
}

// Credenciales de proveedor por sede y ambiente (D8). Los secretos se guardan cifrados con versión de
// clave; las claves viven fuera de la base. cuentaExterna impide compartir una cuenta receptora entre sedes.
model CredencialProveedor {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @db.Uuid
  sedeId         String    @db.Uuid
  proveedor      Proveedor
  ambiente       Ambiente
  cuentaExterna  String?
  publicos       Json
  secretoCifrado String
  pista          String
  // Cuentas vinculadas por OAuth (Mercado Pago): vencimiento del access token. Null = sin renovación.
  tokenVenceEn   DateTime?
  actualizadoPor String?   @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  sede           Sede      @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([sedeId, proveedor, ambiente])
  @@unique([proveedor, ambiente, cuentaExterna])
  @@index([organizacionId])
  @@index([tokenVenceEn])
}

// Identidad compartida en la organización (D13). Sin datos de salud ni fotos.
model Cliente {
  id              String                  @id @default(uuid()) @db.Uuid
  organizacionId  String                  @db.Uuid
  nombre          String
  apellido        String?
  email           String?
  telefono        String?
  sexo            Sexo?
  tipoDocumento   TipoDocumento?
  documento       String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  organizacion    Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sedes           ClienteSede[]
  consentimientos ClienteConsentimiento[]
  reservas        Reserva[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, email])
  @@unique([organizacionId, tipoDocumento, documento])
  @@index([organizacionId, telefono])
}

// Relación del cliente con cada sede; las observaciones son locales y solo las ve quien alcanza la sede.
model ClienteSede {
  organizacionId String   @db.Uuid
  clienteId      String   @db.Uuid
  sedeId         String   @db.Uuid
  observaciones  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cliente        Cliente  @relation(fields: [organizacionId, clienteId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@id([clienteId, sedeId])
  @@index([organizacionId, sedeId])
}

// Texto versionado e inmutable. Cambiar el texto es crear otra versión.
model ConsentimientoVersion {
  id             String                  @id @default(uuid()) @db.Uuid
  organizacionId String                  @db.Uuid
  tipo           TipoConsentimiento
  clave          String
  version        Int
  titulo         String
  texto          String
  creadoPor      String?                 @db.Uuid
  createdAt      DateTime                @default(now())
  organizacion   Organizacion            @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  registros      ClienteConsentimiento[]

  @@unique([organizacionId, clave, version])
  @@unique([organizacionId, id])
}

// Registro inmutable de aceptación o revocación: el estado surge del último registro.
model ClienteConsentimiento {
  id             String                @id @default(uuid()) @db.Uuid
  organizacionId String                @db.Uuid
  clienteId      String                @db.Uuid
  versionId      String                @db.Uuid
  sedeId         String?               @db.Uuid
  accion         AccionConsentimiento
  canal          CanalConsentimiento
  registradoPor  String?               @db.Uuid
  evidencia      Json?
  // Desempata registros del mismo milisegundo: el estado lo define el último insertado.
  orden          Int                   @default(autoincrement())
  createdAt      DateTime              @default(now())
  cliente        Cliente               @relation(fields: [organizacionId, clienteId], references: [organizacionId, id], onDelete: Restrict)
  version        ConsentimientoVersion @relation(fields: [organizacionId, versionId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede?                 @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([organizacionId, clienteId, createdAt])
}

// Catálogo global de la organización (propuesta D12); precio y habilitación son por sede.
model CategoriaServicio {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  nombre         String
  orden          Int          @default(0)
  activo         Boolean      @default(true)
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  servicios      Servicio[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

model Servicio {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizacionId       String                     @db.Uuid
  categoriaId          String                     @db.Uuid
  nombre               String
  descripcion          String?
  // Imagen pública del servicio (portal). Reemplazarla crea otra Imagen y borra la anterior.
  imagenId             String?                    @db.Uuid
  duracionMinutos      Int
  bufferAntesMinutos   Int                        @default(0)
  bufferDespuesMinutos Int                        @default(0)
  // Seña por defecto del servicio. null = sin definir (D3 pendiente): no se ofrece online.
  senaTipo             TipoSena?
  senaValor            Decimal?                   @db.Decimal(12, 2)
  activo               Boolean                    @default(true)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  organizacion         Organizacion               @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  categoria            CategoriaServicio          @relation(fields: [organizacionId, categoriaId], references: [organizacionId, id], onDelete: Restrict)
  imagen               Imagen?                    @relation(fields: [organizacionId, imagenId], references: [organizacionId, id], onDelete: Restrict)
  skills               ServicioSkill[]
  recursos             ServicioRequisitoRecurso[]
  consentimientos      ServicioConsentimiento[]
  sedes                ServicioSede[]
  profesionales        ProfesionalServicio[]
  reservaItems         ReservaItem[]
  ventaItems           VentaItem[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

model Skill {
  id             String             @id @default(uuid()) @db.Uuid
  organizacionId String             @db.Uuid
  nombre         String
  organizacion   Organizacion       @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  servicios      ServicioSkill[]
  profesionales  ProfesionalSkill[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

// El profesional debe tener TODAS las skills requeridas por el servicio.
model ServicioSkill {
  organizacionId String   @db.Uuid
  servicioId     String   @db.Uuid
  skillId        String   @db.Uuid
  servicio       Servicio @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Cascade)
  skill          Skill    @relation(fields: [organizacionId, skillId], references: [organizacionId, id], onDelete: Restrict)

  @@id([servicioId, skillId])
}

model TipoRecurso {
  id             String                     @id @default(uuid()) @db.Uuid
  organizacionId String                     @db.Uuid
  nombre         String
  organizacion   Organizacion               @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  requisitos     ServicioRequisitoRecurso[]
  recursos       Recurso[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
}

// Cantidad de unidades distintas de un tipo que el servicio ocupa durante todo el intervalo.
model ServicioRequisitoRecurso {
  organizacionId String      @db.Uuid
  servicioId     String      @db.Uuid
  tipoRecursoId  String      @db.Uuid
  cantidad       Int
  servicio       Servicio    @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Cascade)
  tipoRecurso    TipoRecurso @relation(fields: [organizacionId, tipoRecursoId], references: [organizacionId, id], onDelete: Restrict)

  @@id([servicioId, tipoRecursoId])
}

// Consentimiento exigido por el servicio, por clave: siempre rige la versión vigente.
model ServicioConsentimiento {
  organizacionId String   @db.Uuid
  servicioId     String   @db.Uuid
  clave          String
  servicio       Servicio @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Cascade)

  @@id([servicioId, clave])
}

model ServicioSede {
  organizacionId   String    @db.Uuid
  servicioId       String    @db.Uuid
  sedeId           String    @db.Uuid
  habilitado       Boolean   @default(false)
  precio           Decimal?  @db.Decimal(12, 2)
  duracionMinutos  Int?
  senaTipo         TipoSena?
  senaValor        Decimal?  @db.Decimal(12, 2)
  reservableOnline Boolean   @default(true)
  updatedAt        DateTime  @updatedAt
  servicio         Servicio  @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Restrict)
  sede             Sede      @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@id([servicioId, sedeId])
  @@index([organizacionId, sedeId])
}

// Profesional de la organización; puede trabajar en varias sedes. Usuario opcional (agenda propia, más adelante).
model Profesional {
  id             String                @id @default(uuid()) @db.Uuid
  organizacionId String                @db.Uuid
  nombre         String
  apellido       String?
  usuarioId      String?               @db.Uuid
  // Foto pública (portal). Reemplazarla crea otra Imagen y borra la anterior.
  fotoId         String?               @db.Uuid
  activo         Boolean               @default(true)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  organizacion   Organizacion          @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  foto           Imagen?               @relation(fields: [organizacionId, fotoId], references: [organizacionId, id], onDelete: Restrict)
  sedes          ProfesionalSede[]
  skills         ProfesionalSkill[]
  servicios      ProfesionalServicio[]
  horarios       HorarioProfesional[]
  bloqueos       BloqueoAgenda[]
  reservaItems   ReservaItem[]
  ventaItems     VentaItem[]
  presencias     PresenciaProfesional[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, usuarioId])
}

// Tablero de recepción (doc 29): la profesional está en el local. Recepción marca la entrada y la salida;
// puede haber varias por día (turno mañana y tarde). Una sola abierta por profesional, en cualquier sede
// (índice parcial en la migración).
model PresenciaProfesional {
  id             String      @id @default(uuid()) @db.Uuid
  organizacionId String      @db.Uuid
  sedeId         String      @db.Uuid
  profesionalId  String      @db.Uuid
  entrada        DateTime
  salida         DateTime?
  entradaPorId   String      @db.Uuid
  salidaPorId    String?     @db.Uuid
  profesional    Profesional @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede        @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, id])
  @@index([sedeId, entrada])
  @@index([profesionalId, entrada])
}

model ProfesionalSede {
  organizacionId String      @db.Uuid
  profesionalId  String      @db.Uuid
  sedeId         String      @db.Uuid
  activo         Boolean     @default(true)
  profesional    Profesional @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede        @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@id([profesionalId, sedeId])
  @@index([organizacionId, sedeId])
}

model ProfesionalSkill {
  organizacionId String      @db.Uuid
  profesionalId  String      @db.Uuid
  skillId        String      @db.Uuid
  profesional    Profesional @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Cascade)
  skill          Skill       @relation(fields: [organizacionId, skillId], references: [organizacionId, id], onDelete: Restrict)

  @@id([profesionalId, skillId])
}

// Habilitación expresa: además de tener las skills, el profesional debe estar habilitado para el servicio.
model ProfesionalServicio {
  organizacionId String      @db.Uuid
  profesionalId  String      @db.Uuid
  servicioId     String      @db.Uuid
  profesional    Profesional @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Cascade)
  servicio       Servicio    @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Restrict)

  @@id([profesionalId, servicioId])
}

// Apertura semanal de la sede. Varios rangos por día = pausas. Vigencia opcional por fecha local.
model HorarioSede {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @db.Uuid
  sedeId         String    @db.Uuid
  diaSemana      Int
  inicioMinutos  Int
  finMinutos     Int
  vigenteDesde   DateTime? @db.Date
  vigenteHasta   DateTime? @db.Date
  sede           Sede      @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([sedeId, diaSemana])
}

// Jornada del profesional en una sede. No puede solaparse con su jornada en otra sede.
model HorarioProfesional {
  id             String      @id @default(uuid()) @db.Uuid
  organizacionId String      @db.Uuid
  profesionalId  String      @db.Uuid
  sedeId         String      @db.Uuid
  diaSemana      Int
  inicioMinutos  Int
  finMinutos     Int
  vigenteDesde   DateTime?   @db.Date
  vigenteHasta   DateTime?   @db.Date
  profesional    Profesional @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede        @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([profesionalId, diaSemana])
  @@index([sedeId, diaSemana])
}

// Fecha especial: sedeId null = toda la organización (feriado). Si la sede tiene filas para la fecha,
// reemplazan a las de la organización. Cerrado, o rango especial de apertura.
model ExcepcionHorario {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String?      @db.Uuid
  fecha          DateTime     @db.Date
  cerrado        Boolean
  inicioMinutos  Int?
  finMinutos     Int?
  motivo         String?
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sede           Sede?        @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@index([organizacionId, fecha])
}

// Ausencia del profesional en instantes UTC; vale en todas sus sedes.
model BloqueoAgenda {
  id             String      @id @default(uuid()) @db.Uuid
  organizacionId String      @db.Uuid
  profesionalId  String      @db.Uuid
  inicio         DateTime
  fin            DateTime
  motivo         String?
  creadoPor      String?     @db.Uuid
  createdAt      DateTime    @default(now())
  profesional    Profesional @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Restrict)

  @@index([profesionalId, inicio])
}

// Unidad física individual de un tipo (cabina 1, láser A) en una sede.
model Recurso {
  id             String               @id @default(uuid()) @db.Uuid
  organizacionId String               @db.Uuid
  sedeId         String               @db.Uuid
  tipoRecursoId  String               @db.Uuid
  nombre         String
  activo         Boolean              @default(true)
  sede           Sede                 @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  tipoRecurso    TipoRecurso          @relation(fields: [organizacionId, tipoRecursoId], references: [organizacionId, id], onDelete: Restrict)
  bloqueos       BloqueoRecurso[]
  ocupaciones    ReservaItemRecurso[]

  @@unique([organizacionId, id])
  @@unique([sedeId, nombre])
}

model BloqueoRecurso {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @db.Uuid
  recursoId      String   @db.Uuid
  inicio         DateTime
  fin            DateTime
  motivo         String?
  recurso        Recurso  @relation(fields: [organizacionId, recursoId], references: [organizacionId, id], onDelete: Restrict)

  @@index([recursoId, inicio])
}

// Reserva: agrupa uno o más ítems consecutivos (D15) de un cliente en una sede.
// Ocupa agenda mientras está CONFIRMADA/ATENDIDA/AUSENTE, o pendiente con expiraEn futuro.
model Reserva {
  id             String          @id @default(uuid()) @db.Uuid
  organizacionId String          @db.Uuid
  sedeId         String          @db.Uuid
  clienteId      String?         @db.Uuid
  canal          CanalReserva
  estado         EstadoReserva
  expiraEn       DateTime?
  notas          String?
  // Reprogramación: la reserva nueva apunta a la que reemplaza (cancelada en la misma transacción).
  reemplazaId    String?         @unique @db.Uuid
  reemplaza      Reserva?        @relation("Reprogramacion", fields: [reemplazaId], references: [id], onDelete: Restrict)
  reemplazadaPor Reserva?        @relation("Reprogramacion")
  // O01 «Atender ahora» (doc 27): cliente que llegó sin turno; el turno arranca al crearse. Para reportes.
  sinTurnoPrevio Boolean         @default(false)
  // Tablero de recepción (doc 29): la atención empezó (al despachar a una clienta sin turno, o cuando llega
  // la clienta con turno) y terminó («Terminó» libera a la profesional y recorta la agenda a ese minuto).
  iniciadaEn     DateTime?
  terminadaEn    DateTime?
  creadoPor      String?         @db.Uuid
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sede           Sede            @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  cliente        Cliente?        @relation(fields: [organizacionId, clienteId], references: [organizacionId, id], onDelete: Restrict)
  items          ReservaItem[]
  eventos        ReservaEvento[]
  tokens         TokenReserva[]
  checkouts      CheckoutPago[]
  pagos          Pago[]
  ventas         Venta[]

  @@unique([organizacionId, id])
  @@index([sedeId, estado])
}

// Un servicio con su profesional e intervalo; snapshots de condiciones al reservar.
model ReservaItem {
  id                   String               @id @default(uuid()) @db.Uuid
  organizacionId       String               @db.Uuid
  reservaId            String               @db.Uuid
  posicion             Int
  servicioId           String               @db.Uuid
  profesionalId        String               @db.Uuid
  inicio               DateTime
  fin                  DateTime
  ocupaDesde           DateTime
  ocupaHasta           DateTime
  duracionMinutos      Int
  bufferAntesMinutos   Int
  bufferDespuesMinutos Int
  precio               Decimal              @db.Decimal(12, 2)
  sena                 Decimal?             @db.Decimal(12, 2)
  // Tablero de recepción (doc 29): su profesional terminó («Terminó» por profesional, servicios a la vez).
  terminadoEn          DateTime?
  reserva              Reserva              @relation(fields: [organizacionId, reservaId], references: [organizacionId, id], onDelete: Restrict)
  servicio             Servicio             @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Restrict)
  profesional          Profesional          @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Restrict)
  recursos             ReservaItemRecurso[]
  ventaItems           VentaItem[]

  @@unique([organizacionId, id])
  @@unique([reservaId, posicion])
  @@index([profesionalId, ocupaDesde])
}

model ReservaItemRecurso {
  organizacionId String      @db.Uuid
  itemId         String      @db.Uuid
  recursoId      String      @db.Uuid
  ocupaDesde     DateTime
  ocupaHasta     DateTime
  item           ReservaItem @relation(fields: [organizacionId, itemId], references: [organizacionId, id], onDelete: Restrict)
  recurso        Recurso     @relation(fields: [organizacionId, recursoId], references: [organizacionId, id], onDelete: Restrict)

  @@id([itemId, recursoId])
  @@index([recursoId, ocupaDesde])
}

// Historial inmutable de la reserva: cada cambio de estado o de horario es un evento nuevo.
model ReservaEvento {
  id             String            @id @default(uuid()) @db.Uuid
  organizacionId String            @db.Uuid
  reservaId      String            @db.Uuid
  tipo           TipoEventoReserva
  estadoAnterior EstadoReserva?
  estadoNuevo    EstadoReserva
  actorId        String?           @db.Uuid
  detalle        Json?
  orden          Int               @default(autoincrement())
  createdAt      DateTime          @default(now())
  reserva        Reserva           @relation(fields: [organizacionId, reservaId], references: [organizacionId, id], onDelete: Restrict)

  @@index([reservaId, orden])
}

// Token opaco del invitado para consultar (y más adelante gestionar) su reserva. Solo se guarda el hash.
model TokenReserva {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @db.Uuid
  reservaId      String    @db.Uuid
  tokenHash      String    @unique @db.Char(64)
  expiraEn       DateTime
  revocadoEn     DateTime?
  createdAt      DateTime  @default(now())
  reserva        Reserva   @relation(fields: [organizacionId, reservaId], references: [organizacionId, id], onDelete: Restrict)

  @@index([reservaId])
}

// Idempotencia de operaciones públicas: misma clave + mismo contenido = misma respuesta.
model ClaveIdempotencia {
  id             String   @id @default(uuid()) @db.Uuid
  organizacionId String   @db.Uuid
  ambito         String
  clave          String
  hashSolicitud  String   @db.Char(64)
  estado         String
  codigo         Int?
  respuesta      Json?
  reservaId      String?  @db.Uuid
  createdAt      DateTime @default(now())
  expiraEn       DateTime

  @@unique([organizacionId, ambito, clave])
  @@index([expiraEn])
}

// Registro durable para límites del portal (por IP o por contacto). Sin datos personales en claro.
model EventoPublico {
  id        String   @id @default(uuid()) @db.Uuid
  tipo      String
  clave     String   @db.Char(64)
  createdAt DateTime @default(now())

  @@index([tipo, clave, createdAt])
}

// Imagen subida desde el backoffice, ya procesada (WebP, sin metadatos EXIF). Es pública: se sirve
// solo mientras la referencia un servicio o profesional. Inmutable: el id sirve de clave de caché.
model Imagen {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  mime           String
  ancho          Int
  alto           Int
  datos          Bytes
  sha256         String        @db.Char(64)
  creadoPor      String?       @db.Uuid
  createdAt      DateTime      @default(now())
  organizacion   Organizacion  @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  servicios      Servicio[]
  profesionales  Profesional[]

  @@unique([organizacionId, id])
}

enum EstadoJob {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  // Agotó los intentos o falló de forma permanente: requiere revisión (M04).
  FALLIDO
  CANCELADO
}

// Trabajo durable (outbox). Se encola en la misma transacción que el cambio que lo origina; la clave
// única deduplica (encolar dos veces el mismo evento no crea dos trabajos). El worker lo toma con un
// lease: si se cae a mitad de camino, al vencer el lease otro worker lo retoma.
model Job {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String?   @db.Uuid
  tipo           String
  clave          String    @unique
  payload        Json
  estado         EstadoJob @default(PENDIENTE)
  intentos       Int       @default(0)
  maxIntentos    Int       @default(8)
  proximoIntento DateTime  @default(now())
  leaseHasta     DateTime?
  leaseDe        String?
  ultimoError    String?
  resultado      Json?
  completadoEn   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([estado, proximoIntento])
  @@index([estado, leaseHasta])
}

// R04. Preferencia de Checkout Pro creada para cobrar la seña de una reserva. Su id es la
// external_reference en Mercado Pago: así un pago se vincula a la reserva sin confiar en el retorno.
model CheckoutPago {
  id             String    @id @default(uuid()) @db.Uuid
  organizacionId String    @db.Uuid
  sedeId         String    @db.Uuid
  reservaId      String    @db.Uuid
  proveedor      Proveedor
  ambiente       Ambiente
  monto          Decimal   @db.Decimal(12, 2)
  preferenciaId  String?
  url            String?
  expiraEn       DateTime
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  reserva        Reserva   @relation(fields: [organizacionId, reservaId], references: [organizacionId, id], onDelete: Restrict)
  pagos          Pago[]

  @@unique([organizacionId, id])
  @@index([reservaId])
}

// R04. Un pago del proveedor (puede haber varios por checkout: rechazado y después aprobado, o duplicado).
// Se identifica por su id externo: notificaciones repetidas actualizan la misma fila.
model Pago {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String       @db.Uuid
  reservaId      String       @db.Uuid
  checkoutId     String       @db.Uuid
  proveedor      Proveedor
  ambiente       Ambiente
  externoId      String
  monto          Decimal      @db.Decimal(12, 2)
  moneda         String
  estado         EstadoPago
  estadoExterno  String
  detalleExterno String?
  motivo         String?
  aprobadoEn     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  reserva        Reserva      @relation(fields: [organizacionId, reservaId], references: [organizacionId, id], onDelete: Restrict)
  checkout       CheckoutPago @relation(fields: [organizacionId, checkoutId], references: [organizacionId, id], onDelete: Restrict)
  ventas         Venta[]

  @@unique([proveedor, ambiente, externoId])
  @@index([reservaId])
}

// ─── Gastos ───────────────────────────────────────────────────────────────────
// O04. Ver docs/25-gastos.md. Bloque propio del módulo; las únicas líneas fuera de él son las
// relaciones inversas en Organizacion y Sede.

// Medio con que se pagó el gasto. EFECTIVO será un egreso de caja cuando exista O02.
enum MedioPagoGasto {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  MERCADO_PAGO
  OTRO
}

enum TipoMovimientoGasto {
  GASTO
  // Anulación: copia el gasto con monto negativo; el original nunca se edita ni se borra.
  REVERSO
}

// Categoría de gasto (alineado a D12): sedeId null = global de la organización (la define el master);
// con sede = local de esa sede (la define quien la administra). Se desactiva, no se borra.
model CategoriaGasto {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String?      @db.Uuid
  nombre         String
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizacion   Organizacion @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sede           Sede?        @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  gastos         Gasto[]

  @@unique([organizacionId, id])
  @@index([organizacionId, sedeId])
}

// Movimiento de gasto, solo inserción (trigger). Un GASTO tiene monto positivo; su REVERSO (único,
// por revierteId) lleva el monto negado y la misma sede, categoría, fecha y medio, más el motivo.
// El total de un período es la suma de los montos: un gasto anulado suma cero.
model Gasto {
  id              String              @id @default(uuid()) @db.Uuid
  organizacionId  String              @db.Uuid
  sedeId          String              @db.Uuid
  categoriaId     String              @db.Uuid
  tipo            TipoMovimientoGasto
  // Fecha local de la sede en que se hizo el gasto. El instante de carga (o de anulación) es createdAt.
  fecha           DateTime            @db.Date
  // ARS: positivo en GASTO, negativo en REVERSO.
  monto           Decimal             @db.Decimal(12, 2)
  medioPago       MedioPagoGasto
  descripcion     String
  // Referencia libre al comprobante (tipo y número, proveedor). Sin archivo por ahora.
  comprobante     String?
  // Quien registró el gasto (o lo anuló, en un REVERSO). Sin FK a Usuario, como los actores de ReservaEvento.
  registradoPorId String              @db.Uuid
  revierteId      String?             @db.Uuid
  motivoAnulacion String?
  createdAt       DateTime            @default(now())
  sede            Sede                @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  categoria       CategoriaGasto      @relation(fields: [organizacionId, categoriaId], references: [organizacionId, id], onDelete: Restrict)
  revierte        Gasto?              @relation("ReversoGasto", fields: [organizacionId, revierteId], references: [organizacionId, id], onDelete: Restrict)
  reverso         Gasto?              @relation("ReversoGasto")
  movimientoCaja  MovimientoCaja?

  @@unique([organizacionId, id])
  // Un gasto tiene a lo sumo un reverso: dos anulaciones simultáneas no pasan las dos.
  @@unique([organizacionId, revierteId])
  @@index([sedeId, fecha])
  @@index([organizacionId, fecha])
}

// P03. Estado de un email transaccional. PENDIENTE: hubo un intento fallido y se reintenta.
// ENVIADO/SIMULADO: el proveedor (o el transporte falso de desarrollo) lo aceptó. Los demás llegan por
// el webhook de Resend y solo avanzan (ver RANGO_ENVIO en @nailnet/domain/resend).
enum EstadoEmail {
  PENDIENTE
  ENVIADO
  SIMULADO
  OMITIDO
  FALLIDO
  DEMORADO
  ENTREGADO
  REBOTADO
  QUEJA
}

// P03. Evidencia de cada email transaccional: a quién, qué, con qué id del proveedor y cómo terminó.
// Una fila por clave de idempotencia (la misma del trabajo y del header Idempotency-Key de Resend).
// Sin claves foráneas a propósito: es un registro de auditoría que sobrevive a la purga de trabajos.
model EnvioEmail {
  id             String      @id @default(uuid()) @db.Uuid
  organizacionId String?     @db.Uuid
  clave          String      @unique
  tipo           String
  reservaId      String?     @db.Uuid
  usuarioId      String?     @db.Uuid
  destinatario   String?
  asunto         String?
  proveedor      String?
  proveedorId    String?     @unique
  estado         EstadoEmail
  intentos       Int         @default(0)
  ultimoError    String?
  // Por qué se omitió, o el detalle del rebote/queja que informó el proveedor.
  motivo         String?
  enviadoEn      DateTime?
  // Último evento de entrega informado por el proveedor (webhook).
  eventoEn       DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([reservaId])
  @@index([usuarioId])
  @@index([organizacionId, createdAt])
  @@index([estado, updatedAt])
}

// ─── Stock ───────────────────────────────────────────────────────────────────
// O03 (doc 26). Productos e insumos globales de la organización; precio de venta y saldo por sede.
// El saldo (StockSede) se deriva de movimientos inmutables y nunca es negativo (CHECK + lock de fila).
// Cantidades Decimal(14,3) en la unidad fija del producto; nunca Number.

enum UnidadMedida {
  UNIDAD
  MILILITRO
  LITRO
  GRAMO
  KILOGRAMO
}

enum TipoMovimientoStock {
  COMPRA
  CONSUMO_INTERNO
  AJUSTE
  VENTA
  TRANSFERENCIA_SALIDA
  TRANSFERENCIA_ENTRADA
  REVERSO
}

// vendible = puede venderse en recepción (O01); si no, es solo de consumo interno.
// La unidad no cambia una vez que hay movimientos: reinterpretaría las cantidades ya registradas.
model Producto {
  id             String            @id @default(uuid()) @db.Uuid
  organizacionId String            @db.Uuid
  nombre         String
  sku            String?
  unidad         UnidadMedida
  vendible       Boolean           @default(false)
  activo         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organizacion   Organizacion      @relation(fields: [organizacionId], references: [id], onDelete: Restrict)
  sedes          ProductoSede[]
  saldos         StockSede[]
  movimientos    MovimientoStock[]
  itemsCompra    CompraItem[]
  itemsVenta     VentaItem[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, nombre])
  @@unique([organizacionId, sku])
}

// Condiciones locales del producto (D12): por ahora solo el precio de venta en la sede.
model ProductoSede {
  organizacionId String   @db.Uuid
  productoId     String   @db.Uuid
  sedeId         String   @db.Uuid
  precio         Decimal? @db.Decimal(12, 2)
  updatedAt      DateTime @updatedAt
  producto       Producto @relation(fields: [organizacionId, productoId], references: [organizacionId, id], onDelete: Restrict)
  sede           Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)

  @@id([productoId, sedeId])
  @@index([organizacionId, sedeId])
}

// Saldo vigente por sede y producto. Solo lo escribe src/stock.ts, bajo lock de esta fila y junto con
// el movimiento que lo explica: siempre igual a la suma de los movimientos.
model StockSede {
  organizacionId String   @db.Uuid
  sedeId         String   @db.Uuid
  productoId     String   @db.Uuid
  cantidad       Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt      DateTime @updatedAt
  sede           Sede     @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  producto       Producto @relation(fields: [organizacionId, productoId], references: [organizacionId, id], onDelete: Restrict)

  @@id([sedeId, productoId])
  @@index([organizacionId, productoId])
}

// Movimiento inmutable (trigger): no se edita ni se borra; se corrige con un REVERSO que apunta al original.
// cantidad lleva signo; saldoResultante es el saldo de la sede después de aplicarlo.
model MovimientoStock {
  id              String              @id @default(uuid()) @db.Uuid
  organizacionId  String              @db.Uuid
  sedeId          String              @db.Uuid
  productoId      String              @db.Uuid
  tipo            TipoMovimientoStock
  cantidad        Decimal             @db.Decimal(14, 3)
  saldoResultante Decimal             @db.Decimal(14, 3)
  motivo          String?
  compraItemId    String?             @db.Uuid
  // Las dos patas de una transferencia comparten este id.
  transferenciaId String?             @db.Uuid
  // Venta que originó el egreso (O01, doc 27).
  ventaId         String?             @db.Uuid
  revierteId      String?             @unique @db.Uuid
  actorId         String              @db.Uuid
  orden           Int                 @default(autoincrement())
  createdAt       DateTime            @default(now())
  sede            Sede                @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  producto        Producto            @relation(fields: [organizacionId, productoId], references: [organizacionId, id], onDelete: Restrict)
  compraItem      CompraItem?         @relation(fields: [organizacionId, compraItemId], references: [organizacionId, id], onDelete: Restrict)
  revierte        MovimientoStock?    @relation("ReversoStock", fields: [revierteId], references: [id], onDelete: Restrict)
  revertidoPor    MovimientoStock?    @relation("ReversoStock")
  venta           Venta?              @relation(fields: [organizacionId, ventaId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([organizacionId, compraItemId])
  @@index([organizacionId, sedeId, productoId, orden])
  @@index([transferenciaId])
  @@index([ventaId])
}

// Compra a proveedor: genera un movimiento COMPRA por ítem. El proveedor es texto libre por ahora.
model Compra {
  id             String       @id @default(uuid()) @db.Uuid
  organizacionId String       @db.Uuid
  sedeId         String       @db.Uuid
  proveedor      String
  comprobante    String?
  fecha          DateTime     @db.Date
  total          Decimal      @db.Decimal(12, 2)
  actorId        String       @db.Uuid
  createdAt      DateTime     @default(now())
  sede           Sede         @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  items          CompraItem[]

  @@unique([organizacionId, id])
  @@index([organizacionId, sedeId, fecha])
}

// Costo unitario por unidad de medida del producto; subtotal = cantidad × costo, al centavo.
model CompraItem {
  id             String           @id @default(uuid()) @db.Uuid
  organizacionId String           @db.Uuid
  compraId       String           @db.Uuid
  posicion       Int
  productoId     String           @db.Uuid
  cantidad       Decimal          @db.Decimal(14, 3)
  costoUnitario  Decimal          @db.Decimal(12, 2)
  subtotal       Decimal          @db.Decimal(12, 2)
  compra         Compra           @relation(fields: [organizacionId, compraId], references: [organizacionId, id], onDelete: Restrict)
  producto       Producto         @relation(fields: [organizacionId, productoId], references: [organizacionId, id], onDelete: Restrict)
  movimiento     MovimientoStock?

  @@unique([organizacionId, id])
  @@unique([compraId, posicion])
}

// ─── Incidencias ─────────────────────────────────────────────────────────────
// M04 (doc 28). La incidencia se deriva del estado de su fuente (Job, Pago, EnvioEmail; comprobantes
// con M02); acá solo queda lo que hizo una persona sobre ella: quién, cuándo, qué y con qué nota.
// Solo inserción (trigger). Sin claves foráneas a propósito, como EnvioEmail: es auditoría sobre
// fuentes distintas y tiene que sobrevivir a la purga de trabajos.

enum FuenteIncidencia {
  TRABAJO
  PAGO
  EMAIL
}

enum TipoAccionIncidencia {
  REVISADA
  RESUELTA
  REABIERTA
  // El trabajo FALLIDO volvió a PENDIENTE (mismo id y clave: el manejador es idempotente).
  REINTENTADA
  // La devolución se pidió o se hizo fuera del sistema. No la da por completa (M01, D5).
  DEVOLUCION_GESTIONADA
}

model AccionIncidencia {
  id             String               @id @default(uuid()) @db.Uuid
  // Organización del actor: la de la fuente o, para trabajos del sistema (sin organización), la del master.
  organizacionId String               @db.Uuid
  fuente         FuenteIncidencia
  entidadId      String               @db.Uuid
  // Tipo de incidencia al momento de la acción (TRABAJO_FALLIDO, PAGO_A_DEVOLVER…).
  incidencia     String
  sedeId         String?              @db.Uuid
  accion         TipoAccionIncidencia
  nota           String
  // Estado de la fuente y su último cambio al actuar: separa ocurrencias (un trabajo que vuelve a fallar).
  estadoFuente   String
  marcaFuente    DateTime
  actorId        String               @db.Uuid
  createdAt      DateTime             @default(now())

  @@index([fuente, entidadId, createdAt])
  @@index([organizacionId, createdAt])
}

// ─── Ventas y caja ───────────────────────────────────────────────────────────
// O01 y O02 (doc 27). Venta por sede con ítems de servicio (desde un turno atendido, precio congelado)
// y de producto; cobros manuales con su medio; la seña aprobada por Mercado Pago se aplica como anticipo
// sin volver a ingresar. Caja por sede: solo efectivo; los cobros digitales se informan aparte.
// Todo es de solo inserción salvo las transiciones de estado de Venta y Caja, acotadas por trigger.
// Las líneas fuera del bloque son solo relaciones inversas (Sede, Reserva, ReservaItem, Pago, Producto, Gasto).

enum MedioCobro {
  EFECTIVO
  TRANSFERENCIA
  TARJETA_DEBITO
  TARJETA_CREDITO
  MERCADO_PAGO
  OTRO
}

enum EstadoVenta {
  // Falta cobrar parte del total.
  PENDIENTE
  // Anticipo + cobros = total. Punto de enganche de la facturación cuando se defina D9.
  COMPLETADA
  // Anulada por reverso: cobros revertidos, anticipo liberado y, si se pidió, stock repuesto.
  ANULADA
}

enum TipoItemVenta {
  SERVICIO
  PRODUCTO
}

enum TipoCobro {
  COBRO
  // Anulación de un cobro: monto negado, mismo medio. El cobro original no cambia.
  REVERSO
}

enum EstadoCaja {
  ABIERTA
  CERRADA
}

enum TipoMovimientoCaja {
  INGRESO_COBRO
  EGRESO_GASTO
  ENTRADA
  SALIDA
  REVERSO
}

// Venta de recepción. Importes en ARS Decimal(12,2). total = subtotal − descuento; el anticipo (seña
// aprobada de la reserva) cubre parte del total y nunca es un ingreso de caja. Los importes y los ítems
// no cambian: solo el estado avanza (PENDIENTE → COMPLETADA → ANULADA), controlado por trigger.
model Venta {
  id                String            @id @default(uuid()) @db.Uuid
  organizacionId    String            @db.Uuid
  sedeId            String            @db.Uuid
  // Turno atendido que se cobra (opcional: una venta de productos sueltos no tiene reserva).
  reservaId         String?           @db.Uuid
  // Fecha local de la sede en que se registró la venta.
  fecha             DateTime          @db.Date
  subtotal          Decimal           @db.Decimal(12, 2)
  descuento         Decimal           @default(0) @db.Decimal(12, 2)
  total             Decimal           @db.Decimal(12, 2)
  // Seña de Mercado Pago aplicada (0 si no hubo) y el pago que la respalda.
  anticipo          Decimal           @default(0) @db.Decimal(12, 2)
  pagoAnticipoId    String?           @db.Uuid
  estado            EstadoVenta
  // Clave del formulario: un doble envío devuelve la misma venta en vez de crear otra.
  claveIdempotencia String
  registradoPorId   String            @db.Uuid
  createdAt         DateTime          @default(now())
  completadaEn      DateTime?
  anuladaEn         DateTime?
  anuladaPorId      String?           @db.Uuid
  motivoAnulacion   String?
  sede              Sede              @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  reserva           Reserva?          @relation(fields: [organizacionId, reservaId], references: [organizacionId, id], onDelete: Restrict)
  pagoAnticipo      Pago?             @relation(fields: [pagoAnticipoId], references: [id], onDelete: Restrict)
  items             VentaItem[]
  cobros            CobroVenta[]
  movimientosStock  MovimientoStock[]

  @@unique([organizacionId, id])
  @@unique([organizacionId, claveIdempotencia])
  @@index([sedeId, fecha])
  @@index([reservaId])
}

// Ítem inmutable (la comanda). SERVICIO: servicio realmente hecho, con la profesional que lo hizo (para
// comisiones, L01); viene del turno (reservaItemId) o se agregó al cobrar. PRODUCTO: cantidad en la unidad
// del producto; su egreso de stock es un MovimientoStock VENTA. precioLista es el propuesto (pactado en
// el turno o lista de la sede); precioUnitario, el cobrado (editable en servicios).
model VentaItem {
  id             String        @id @default(uuid()) @db.Uuid
  organizacionId String        @db.Uuid
  ventaId        String        @db.Uuid
  posicion       Int
  tipo           TipoItemVenta
  reservaItemId  String?       @db.Uuid
  servicioId     String?       @db.Uuid
  profesionalId  String?       @db.Uuid
  productoId     String?       @db.Uuid
  // Snapshot legible (servicio y profesional, o producto).
  descripcion    String
  cantidad       Decimal       @db.Decimal(14, 3)
  precioLista    Decimal?      @db.Decimal(12, 2)
  precioUnitario Decimal       @db.Decimal(12, 2)
  subtotal       Decimal       @db.Decimal(12, 2)
  venta          Venta         @relation(fields: [organizacionId, ventaId], references: [organizacionId, id], onDelete: Restrict)
  reservaItem    ReservaItem?  @relation(fields: [organizacionId, reservaItemId], references: [organizacionId, id], onDelete: Restrict)
  servicio       Servicio?     @relation(fields: [organizacionId, servicioId], references: [organizacionId, id], onDelete: Restrict)
  profesional    Profesional?  @relation(fields: [organizacionId, profesionalId], references: [organizacionId, id], onDelete: Restrict)
  producto       Producto?     @relation(fields: [organizacionId, productoId], references: [organizacionId, id], onDelete: Restrict)

  @@unique([ventaId, posicion])
}

// Cobro manual de una venta, solo inserción. Un COBRO en efectivo lleva la caja abierta en que entró;
// los demás medios la llevan si había una abierta (para el resumen por medio del cierre). El REVERSO
// (único por cobro) niega el monto y, si es efectivo, sale de la caja abierta al momento de anular.
model CobroVenta {
  id                String          @id @default(uuid()) @db.Uuid
  organizacionId    String          @db.Uuid
  sedeId            String          @db.Uuid
  ventaId           String          @db.Uuid
  tipo              TipoCobro
  medio             MedioCobro
  monto             Decimal         @db.Decimal(12, 2)
  // Número de operación, últimos dígitos de la tarjeta, etc. Texto libre opcional.
  referencia        String?
  cajaId            String?         @db.Uuid
  revierteId        String?         @db.Uuid
  motivo            String?
  claveIdempotencia String?
  registradoPorId   String          @db.Uuid
  createdAt         DateTime        @default(now())
  sede              Sede            @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  venta             Venta           @relation(fields: [organizacionId, ventaId], references: [organizacionId, id], onDelete: Restrict)
  caja              Caja?           @relation(fields: [organizacionId, cajaId], references: [organizacionId, id], onDelete: Restrict)
  revierte          CobroVenta?     @relation("ReversoCobro", fields: [organizacionId, revierteId], references: [organizacionId, id], onDelete: Restrict)
  reverso           CobroVenta?     @relation("ReversoCobro")
  movimientoCaja    MovimientoCaja?

  @@unique([organizacionId, id])
  @@unique([organizacionId, revierteId])
  @@unique([organizacionId, claveIdempotencia])
  @@index([ventaId])
  @@index([cajaId])
  @@index([sedeId, createdAt])
}

// Caja de una sede desde su apertura hasta su cierre. Una sola ABIERTA por sede (índice único parcial).
// El cierre guarda esperado, contado y diferencia, y ya no cambia: las correcciones posteriores son
// movimientos de la caja que esté abierta.
model Caja {
  id             String           @id @default(uuid()) @db.Uuid
  organizacionId String           @db.Uuid
  sedeId         String           @db.Uuid
  estado         EstadoCaja
  montoInicial   Decimal          @db.Decimal(12, 2)
  abiertaPorId   String           @db.Uuid
  abiertaEn      DateTime         @default(now())
  cerradaPorId   String?          @db.Uuid
  cerradaEn      DateTime?
  esperado       Decimal?         @db.Decimal(12, 2)
  contado        Decimal?         @db.Decimal(12, 2)
  diferencia     Decimal?         @db.Decimal(12, 2)
  observaciones  String?
  sede           Sede             @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  movimientos    MovimientoCaja[]
  cobros         CobroVenta[]

  @@unique([organizacionId, id])
  @@index([sedeId, abiertaEn])
}

// Movimiento de efectivo, solo inserción. monto con signo; esperado = montoInicial + suma de montos.
model MovimientoCaja {
  id              String             @id @default(uuid()) @db.Uuid
  organizacionId  String             @db.Uuid
  sedeId          String             @db.Uuid
  cajaId          String             @db.Uuid
  tipo            TipoMovimientoCaja
  monto           Decimal            @db.Decimal(12, 2)
  motivo          String?
  // Origen: el cobro en efectivo (o su reverso), el gasto en efectivo (o su reverso), o el movimiento revertido.
  cobroId         String?            @db.Uuid
  gastoId         String?            @db.Uuid
  revierteId      String?            @db.Uuid
  registradoPorId String             @db.Uuid
  orden           Int                @default(autoincrement())
  createdAt       DateTime           @default(now())
  sede            Sede               @relation(fields: [organizacionId, sedeId], references: [organizacionId, id], onDelete: Restrict)
  caja            Caja               @relation(fields: [organizacionId, cajaId], references: [organizacionId, id], onDelete: Restrict)
  cobro           CobroVenta?        @relation(fields: [organizacionId, cobroId], references: [organizacionId, id], onDelete: Restrict)
  gasto           Gasto?             @relation(fields: [organizacionId, gastoId], references: [organizacionId, id], onDelete: Restrict)
  revierte        MovimientoCaja?    @relation("ReversoCaja", fields: [organizacionId, revierteId], references: [organizacionId, id], onDelete: Restrict)
  reverso         MovimientoCaja?    @relation("ReversoCaja")

  @@unique([organizacionId, id])
  @@unique([organizacionId, cobroId])
  @@unique([organizacionId, gastoId])
  @@unique([organizacionId, revierteId])
  @@index([cajaId, orden])
}
